# AlgoT2V environment configuration.
#
# Copy this file to `.env` and fill in your own values. The loader is
# `pydantic_settings.BaseSettings` in config.py; any field defined there can
# be overridden here by its upper-snake-case name.
#
# Values shown below are *safe defaults* / placeholders. Required fields are
# marked with [REQUIRED]; everything else is optional.

# =============================================================================
# [REQUIRED] LLM reasoning (OpenRouter-compatible endpoint)
# =============================================================================
OPENROUTER_API_KEY=sk-your-openrouter-key
# Default endpoint can be any OpenAI-compatible gateway. Leave blank to use
# the value hardcoded in config.py.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional model overrides (falls back to config.py defaults)
# REASONING_MODEL=anthropic/claude-sonnet-4
# MULTIMODAL_MODEL=google/gemini-2.5-pro

# =============================================================================
# [REQUIRED] Multimodal script generation (Google Gemini)
# =============================================================================
GOOGLE_API_KEY=your-google-ai-studio-key

# =============================================================================
# TTS provider (default: edge → free, no API key required)
#   Allowed values: edge | openai | elevenlabs | coqui
# =============================================================================
TTS_PROVIDER=edge

# ---- Edge TTS (used when TTS_PROVIDER=edge) ---------------------------------
# Popular Chinese voices:
#   zh-CN-YunxiNeural    (male, professional narration - default)
#   zh-CN-YunyangNeural  (male, news broadcast)
#   zh-CN-XiaoxiaoNeural (female, warm)
#   zh-CN-XiaoyiNeural   (female, bright)
EDGE_TTS_VOICE=zh-CN-YunxiNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%
EDGE_TTS_PITCH=+0Hz

# ---- OpenAI TTS (used when TTS_PROVIDER=openai) ------------------------------
# OPENAI_API_KEY=sk-...
# OPENAI_VOICE=nova
# OPENAI_MODEL=tts-1

# ---- ElevenLabs TTS (used when TTS_PROVIDER=elevenlabs) ----------------------
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...
# ELEVENLABS_MODEL_ID=eleven_v3

# =============================================================================
# Manim rendering
# =============================================================================
# Quality preset: l (480p15) | m (720p30) | h (1080p30) | p (1080p60) | k (1440p60/4k)
MANIM_QUALITY=p
# Single-scene render timeout (seconds). Large algorithm scenes may need >=1200.
MANIM_RENDER_TIMEOUT=1800

# ---- Static lint + LLM fix pass (runs before rendering) ---------------------
# Requires the `third_party/manim-linter` git submodule to be initialized
# (git submodule update --init --recursive). Safe to leave enabled even if the
# submodule is missing - lint step silently skips in that case.
MANIM_LINT_ENABLED=true
MANIM_LINT_MAX_FIX_ATTEMPTS=2

# ---- Render-failure auto-fix loop (runs AFTER rendering crashes) ------------
# When Manim exits non-zero at render time (e.g. a LLM-generated scene hits a
# TypeError / AttributeError the static lint cannot catch), the agent feeds
# stderr back to the LLM, obtains a patched scene file, and re-renders up to
# N additional rounds. Keep enabled unless debugging.
MANIM_RENDER_FIX_ENABLED=true
MANIM_RENDER_FIX_MAX_ATTEMPTS=2

# =============================================================================
# Observability (optional) - Langfuse tracing
# =============================================================================
# Leave empty to disable tracing. Enable BOTH keys to activate.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# =============================================================================
# Output directory (default: ./output)
# =============================================================================
# OUTPUT_DIR=output

# =============================================================================
# Knowledge Curator agent (optional)
#   Rewrites raw algorithm materials (title/steps/code/analysis) into
#   animation-ready knowledge docs consumed by the main pipeline.
# =============================================================================
# CURATOR_REASONING_TOKENS=4096
# CURATOR_REASONING_EFFORT=medium
# CURATOR_TEMPERATURE=0.3
# CURATOR_MAX_TOKENS=16384
# CURATOR_OUTPUT_DIR=data/knowledge
